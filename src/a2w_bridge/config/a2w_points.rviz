Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 90; 90; 90
      Alpha: 0.4
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.4
      Show Names: true
    # ===== 机器人模型（需要同时跑关节显示：ros2 launch a2w_bridge a2w_joint_display.launch.py）
    # 默认关闭；想在点云里对照机身姿怂时勾上（用 /robot_description + 桥发的静态 TF）
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel (可选)
      Enabled: false
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 0.6
    # ===== 默认只显示 /a2w/points 这一项 =====
    # single 模式下桥把**当前源**的点云都发在这一个话题上，内容由 JSON 的 pointcloud.source
    # 决定（当前配置：front = 前雷达；也可设 fused = 前后融合、auto = 断流轮换）。
    # 改配色/点大小：选中本行后在右侧面板改。
    - Class: rviz_default_plugins/PointCloud2
      Name: a2w/points (single 模式，源见 JSON)
      Enabled: true
      Topic:
        Value: /a2w/points
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Size (m): 0.01
      Alpha: 1
      Decay Time: 0.2
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Min Value: -1
      Max Value: 3
      Autocompute Intensity Bounds: true
      Use Fixed Frame: true
      Selectable: true
    # ===== 以下三路只在 pointcloud.mode=multi 时才有数据，默认不显示 =====
    # 想同时看前后雷达：把 JSON 改成 "mode": "multi" 重启桥，再把下面三段的
    # 注释去掉（每段从 "- Class:" 到下一个同级条目之前），或直接在 RViz 里点 Add
    # 加三个 PointCloud2 分别填 /a2w/points_fused、/a2w/points_front、/a2w/points_rear
    #
    # - Class: rviz_default_plugins/PointCloud2
    #   Name: a2w/points_fused (multi)
    #   Enabled: false
    #   Topic: {Value: /a2w/points_fused, Depth: 5, History Policy: Keep Last,
    #           Reliability Policy: Best Effort, Durability Policy: Volatile}
    #   Style: Points
    #   Size (Pixels): 2
    #   Alpha: 1
    #   Decay Time: 0.2
    #   Position Transformer: XYZ
    #   Color Transformer: AxisColor
    #   Axis: Z
    #   Use Fixed Frame: true
    #
    # - Class: rviz_default_plugins/PointCloud2
    #   Name: a2w/points_front (multi)
    #   Enabled: false
    #   Topic: {Value: /a2w/points_front, Depth: 5, History Policy: Keep Last,
    #           Reliability Policy: Best Effort, Durability Policy: Volatile}
    #   Style: Points
    #   Size (Pixels): 2
    #   Alpha: 1
    #   Decay Time: 0.2
    #   Position Transformer: XYZ
    #   Color Transformer: FlatColor
    #   Color: 80; 200; 120
    #   Use Fixed Frame: true
    #
    # - Class: rviz_default_plugins/PointCloud2
    #   Name: a2w/points_rear (multi)
    #   Enabled: false
    #   Topic: {Value: /a2w/points_rear, Depth: 5, History Policy: Keep Last,
    #           Reliability Policy: Best Effort, Durability Policy: Volatile}
    #   Style: Points
    #   Size (Pixels): 2
    #   Alpha: 1
    #   Decay Time: 0.2
    #   Position Transformer: XYZ
    #   Color Transformer: FlatColor
    #   Color: 230; 140; 60
    #   Use Fixed Frame: true
  Global Options:
    # base_link = 机器人本体（桥发 base_link→a2w/lidar→a2w/lidar_rear 静态 TF，
    # 也用 URDF 的根，所以点云能和机器人模型叠着看）；改成 a2w/lidar 就是雷达视角
    Fixed Frame: base_link
    Frame Rate: 30
    Background Color: 40; 40; 40
    Default Light: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 12
      Focal Point: [0, 0, 0]
      Yaw: 2.35
      Pitch: -0.42
Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Height: 1000
  Width: 1600
  X: 220
  Y: 110
  Hide Left Dock: false
  Hide Right Dock: false
