<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mid360_bringup</name>
  <version>0.1.0</version>
  <description>
    Mid-360 + Point-LIO 的周边集成(Mid-360 / Point-LIO 均为本仓库内的本地上游包)。
    目前包含:Point-LIO 点云 → octomap 三维占据栅格。
    本包只放 launch / config,不含编译产物。
  </description>
  <maintainer email="xiaozhuABCD1234@163.com">xiaozhu</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 运行时依赖 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- 被集成的节点 -->
  <exec_depend>point_lio</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>octomap_server</exec_depend>
  <exec_depend>octomap_msgs</exec_depend>
  <exec_depend>octomap_rviz_plugins</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
