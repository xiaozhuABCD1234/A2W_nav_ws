Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
    CurrentViewClass: rviz_default_plugins/Orbit
    Views:
      - Class: rviz_default_plugins/Orbit
        Name: Orbit
        Distance: 30
        Focal Point:
          X: 0
          Y: 0
          Z: 0
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Plane Cell Count: 40
      Cell Size: 1
      Color: 160; 160; 164
      Line Style: Lines

    # 点云本体。PCD 里带 intensity 字段(point_lio 落盘的是
    # x y z normal_x normal_y normal_z intensity curvature),所以默认按强度着色,
    # 能看出墙面/地面的明暗差别;想看纯几何改成 Color Transformer: FlatColor。
    - Class: rviz_default_plugins/PointCloud2
      Name: cloud_pcd
      Enabled: true
      Topic:
        Value: /cloud_pcd
      # 话题的 QoS 上游是 RELIABLE/VOLATILE,这里保持默认即可(别改成 Transient Local:
      # 那样一旦对方用默认 volatile 发布就收不到了)。
      Style: Points
      Size (Pixels): 1
      Size (m): 0.01
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: Intensity
      Use Fixed Frame: true
      Queue Size: 5

    # 世界系原点(建图起点)。没 TF 也不影响:它画在 (0,0,0)。
    - Class: rviz_default_plugins/Axes
      Name: origin
      Enabled: true
      Length: 1
      Radius: 0.1
      Reference Frame: <Fixed Frame>

  Global Options:
    Fixed Frame: camera_init
    Background Color: 20; 20; 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Window Geometry:
    Width: 1280
    Height: 800
